# Copiez ce fichier vers .env et renseignez les valeurs. Ne commitez jamais
# de vrai secret — voir docs/security.md.

# development | staging | production — bloque seed:dev quand "production"
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Base de données (PostgreSQL) ------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/saldaeconnect?schema=public"
# Base séparée utilisée uniquement par `prisma migrate dev` pour calculer les
# migrations sans toucher à la base principale.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/saldaeconnect_shadow?schema=public"

# --- Authentification (Better Auth) -----------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Chiffrement applicatif des champs sensibles (passeports, données d'identité
# des transactions). openssl rand -hex 16
DATA_ENCRYPTION_KEY=""

# --- Emails ------------------------------------------------------------------
# console (journalise dans le terminal, par défaut) | resend | postmark
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="SaldaeConnect <no-reply@saldaeconnect.example>"

# --- Stockage de fichiers ------------------------------------------------------
# local (développement) | s3 (production — R2, S3, Scaleway, MinIO…)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./.storage"
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# --- Génération de PDF (devis, factures) --------------------------------------
PDF_RENDERER="chromium"
CHROMIUM_PATH=""
GOTENBERG_URL=""

# --- Tâches planifiées ---------------------------------------------------------
# Protège les routes /api/cron/*. openssl rand -hex 16
CRON_SECRET=""

# --- Limitation de débit --------------------------------------------------------
# postgres (par défaut, aucun service supplémentaire) | redis
RATE_LIMIT_STORE="postgres"
REDIS_URL=""

# --- Anti-spam (facultatif) -----------------------------------------------------
TURNSTILE_SECRET_KEY=""

# --- Antivirus (facultatif, si l'infrastructure le permet) ----------------------
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# --- Journalisation ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="debug"
